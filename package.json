{
  "name": "clasro",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx index.ts src tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "coord": "node scripts/coord.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
