{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/coord.mjs\" inbox claude --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/coord.mjs\" inbox claude --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@anthropic-plugin-directory": true
  }
}
