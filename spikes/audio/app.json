{
  "expo": {
    "name": "Bajo Lab",
    "slug": "clasro-audio-lab",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.clasro.audiolab",
      "supportsTablet": false
    },
    "android": {
      "package": "com.clasro.audiolab"
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Bajo Lab usa el micrófono para el afinador. El audio se procesa en el dispositivo y no se guarda.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false
        }
      ]
    ]
  }
}
